                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Cliente Jose Lema creado con exito\", function () {",
                  "    pm.expect(jsonData.nombre).to.eql(\"Jose Lema\");",
                  "    pm.expect(jsonData.identificacion).to.eql(\"1234567890\");",
                  "    pm.expect(jsonData.estado).to.eql(true);",
                  "});",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"clienteJoseId\", jsonData.id);",
